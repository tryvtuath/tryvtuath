# ============================================================================
# CONFIGURAÇÃO DE AMBIENTE DO BACK-END — TRYV TUATH® (INFINITEPAY + PAYPAL)
# ============================================================================
# Copie este arquivo para backend/.env (nunca versione o arquivo .env real no GitHub).

PORT=3001
SITE_PUBLIC_URL=https://www.tryvtuath.com.br

# Segredo HMAC para assinatura de tokens de liberação no servidor
INFINITEPAY_WEBHOOK_SECRET=substitua-por-uma-chave-secreta-forte
INFINITEPAY_HANDLE=tryvtuath

# ----------------------------------------------------------------------------
# CONTA OFICIAL PAYPAL BUSINESS — TRYV TUATH
# Empresa: 54.492.316 Tryv Tuath
# E-mail: tryvtuathterapias@gmail.com
# Moeda de cobrança: USD
# Obtenha o Client ID e o Client Secret em:
# https://developer.paypal.com/dashboard/applications
# ----------------------------------------------------------------------------
# Ambiente: "sandbox" (para testes) ou "live" (para pagamentos reais)
PAYPAL_ENV=sandbox
PAYPAL_MERCHANT_NAME="54.492.316 Tryv Tuath"
PAYPAL_MERCHANT_EMAIL=tryvtuathterapias@gmail.com
PAYPAL_CLIENT_ID=COLE_AQUI_SEU_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=COLE_AQUI_SEU_PAYPAL_CLIENT_SECRET
PAYPAL_WEBHOOK_ID=

# ----------------------------------------------------------------------------
# PREÇOS OFICIAIS EM USD (CALCULADOS PARA LÍQUIDO MÍNIMO DE R$ 37 E R$ 97)
# Standard Analysis: US$ 7.78 | Complete Deep Analysis: US$ 19.86
# ----------------------------------------------------------------------------
PAYPAL_PRECO_STANDARD_USD=7.78
PAYPAL_PRECO_PROFUNDA_USD=19.86
PAYPAL_COTACAO_BRL_USD=5.6666
PAYPAL_COTACAO_FALLBACK_BRL_USD=5.6666
PAYPAL_MARGEM_SEGURANCA_PCT=3.00
