# ============================================================================
# CONFIGURAÇÃO DE AMBIENTE DO BACK-END — TRYV TUATH® (INFINITEPAY + PAYPAL)
# ============================================================================
# Copie este arquivo para backend/.env (nunca versione o arquivo .env real no GitHub).

PORT=3001
SITE_PUBLIC_URL=https://www.tryvtuath.com.br

# Segredo HMAC para assinatura de tokens de liberação no servidor
INFINITEPAY_WEBHOOK_SECRET=substitua-por-uma-chave-secreta-forte
INFINITEPAY_HANDLE=tryvtuath

# ----------------------------------------------------------------------------
# CREDENCIAIS PAYPAL (CHECKOUT INTERNACIONAL EM USD)
# Obtenha em: https://developer.paypal.com/dashboard/applications
# ----------------------------------------------------------------------------
# Ambiente: "sandbox" (testes) ou "live" (produção)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=SEU_PAYPAL_CLIENT_ID_AQUI
PAYPAL_CLIENT_SECRET=SEU_PAYPAL_CLIENT_SECRET_AQUI
PAYPAL_WEBHOOK_ID=

# ----------------------------------------------------------------------------
# PARÂMETROS DE FORMAÇÃO DO PREÇO EM USD (PROTEÇÃO DO VALOR LÍQUIDO EM BRL)
# Fórmula: Preço USD = ((valorLiquidoBRL / (cotacaoBrlUsd * 0.965)) + 0.30) / 0.936
# ----------------------------------------------------------------------------
# Se PAYPAL_COTACAO_BRL_USD ficar em branco, o servidor consulta automaticamente
# a cotação comercial USD/BRL atualizada (AwesomeAPI / Open ER API) e usa
# PAYPAL_COTACAO_FALLBACK_BRL_USD apenas como contingência identificada.
PAYPAL_COTACAO_BRL_USD=
PAYPAL_COTACAO_FALLBACK_BRL_USD=5.75
PAYPAL_MARGEM_SEGURANCA_PCT=3.00
